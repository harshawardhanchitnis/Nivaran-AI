# Copy this file to .env.local and fill it in. Never commit .env.local.
# On Vercel, add the same names under Project Settings > Environment Variables.

# --- Public: also compiled into the browser bundle -------------------------
# Supabase > Project Settings > API
SUPABASE_URL=
# The publishable key (sb_publishable_...). Never a secret key.
SUPABASE_PUBLISHABLE_KEY=

# --- Server only: Vercel Functions ------------------------------------------
# Google AI Studio key (primary model)
GOOGLE_GENERATIVE_AI_API_KEY=
# Groq key (fallback model)
GROQ_API_KEY=

LLM_PRIMARY_MODEL=gemini-3.8-flash
LLM_FALLBACK_MODEL=qwen/qwen3.8-27b

# Lets the /status page spend one model call to prove the key works.
# Set to false on the public deployment once the check has passed.
ENABLE_LLM_CHECK=true

# --- Local development only -------------------------------------------------
API_PORT=3000
