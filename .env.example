# Copy this file to .env.local and fill it in. Never commit .env.local.
# On Vercel, add the same names under Project Settings > Environment Variables.

# --- Public: also compiled into the browser bundle -------------------------
# Supabase > Project Settings > API
SUPABASE_URL=
# The publishable key (sb_publishable_...). Never a secret key.
SUPABASE_PUBLISHABLE_KEY=

# --- Server only: Vercel Functions ------------------------------------------
# Google AI Studio key (Gemini lineup entries)
GOOGLE_GENERATIVE_AI_API_KEY=
# Groq key (Qwen lineup entry)
GROQ_API_KEY=

# Every model call uses one of these task lineups (one to six IDs each).
LLM_VISION_LINEUP=gemini-3.6-flash,gemini-3.8-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.7-flash,qwen/qwen3.8-27b
LLM_TEXT_LINEUP=qwen/qwen3.8-27b,gemini-3.5-flash-lite,gemini-3.5-flash,gemini-3.6-flash,gemini-3.8-flash,gemini-3.7-flash
# 1–8 seconds per attempt, no SDK retries; six attempts fit the 60-second function budget.
LLM_ATTEMPT_TIMEOUT_MS=8000
# Server-only cooldown signature, prepared by node scripts/prepare-model-cooldowns.mjs.
# Apply 0005 and the generated ignored setup SQL; never put this setting in browser code.
MODEL_COOLDOWN_SIGNING_SECRET=

# Lets the /status page spend one model call to prove the key works.
# Set to false on the public deployment once the check has passed.
ENABLE_LLM_CHECK=true

# --- Local development only -------------------------------------------------
API_PORT=3000
