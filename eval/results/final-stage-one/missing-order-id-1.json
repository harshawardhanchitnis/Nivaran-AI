    "draft": {
      "id": "9871c419-b32c-43a6-9ac7-aca827743edd",
      "case_id": "14155a73-7fee-446c-a70d-38fa7376bd8e",
      "user_id": "synthetic-evaluation-owner",
      "plan_id": "b2b9177e-9315-471a-9cf0-c511db282d36",
      "kind": "grievance_officer",
